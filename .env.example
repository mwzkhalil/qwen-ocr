# ── Required ──────────────────────────────────────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Paths ─────────────────────────────────────────────────
LOCAL_DATASET_DIR=/workspace/hf_dataset
OUTPUT_DIR=/workspace/outputs
MODEL_SAVE_DIR=/workspace/outputs/qwen_lora

# ── Model ─────────────────────────────────────────────────
BASE_MODEL=unsloth/Qwen3.5-0.8B
LOAD_IN_4BIT=false

# ── LoRA ──────────────────────────────────────────────────
LORA_R=16
LORA_ALPHA=16
LORA_DROPOUT=0.0

# ── Training ──────────────────────────────────────────────
PER_DEVICE_BATCH_SIZE=4
PER_DEVICE_EVAL_BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=8
WARMUP_STEPS=100
MAX_STEPS=5000
NUM_TRAIN_EPOCHS=1
LEARNING_RATE=2e-4
WEIGHT_DECAY=0.01
LR_SCHEDULER=cosine
MAX_LENGTH=1024
SEED=3407
LOGGING_STEPS=25
EVAL_STEPS=500

# ── Data ──────────────────────────────────────────────────
DATASET_NUM_PROC=4
SHARD_SIZE=1000
VAL_FRAC=0.05
MAX_WORKERS=16

# ── Sampling (set to -1 for all rows) ─────────────────────
TRAIN_SAMPLES=-1
VAL_SAMPLES=-1
MAX_SAMPLES_PER_DS=-1

# ── Export ────────────────────────────────────────────────
SAVE_MERGED_16BIT=true
SAVE_GGUF_Q8=true
SAVE_GGUF_Q4_K_M=true

# ── OCR prompt (sent to model as user instruction) ────────
OCR_PROMPT=اس تصویر سے تمام متن نکالیں۔ صرف متن لکھیں۔

# ── LoRA target layers ────────────────────────────────────
FINETUNE_VISION_LAYERS=true
FINETUNE_LANGUAGE_LAYERS=true
FINETUNE_ATTENTION_MODULES=true
FINETUNE_MLP_MODULES=true
